# Template environment STAGING — jangan isi nilai nyata di file ini.
# Salin ke secret manager/platform, bukan ke repository.
# Jangan memakai kredensial produksi.

# ---------- Runtime web service ----------
NODE_ENV=production
PORT=4173
NODE_VERSION=24

# PostgreSQL staging. Wajib TLS. Jangan arahkan ke database produksi.
DATABASE_URL=postgresql://<staging-user>:<staging-password>@<staging-db-host>:5432/orderguard_staging?sslmode=require

# Reverse proxy Render/Cloudflare.
ORDERGUARD_TRUST_PROXY=1

# Origin staging eksak, tanpa path/query/wildcard.
ORDERGUARD_ALLOWED_ORIGINS=https://<staging-host>

# Session dan rate limit.
ORDERGUARD_SESSION_HOURS=8
ORDERGUARD_LOGIN_WINDOW_MINUTES=15
ORDERGUARD_LOGIN_MAX_ATTEMPTS=5
ORDERGUARD_LOGIN_MAX_IP_ATTEMPTS=20

# Bootstrap hanya untuk database kosong.
# Hapus ORDERGUARD_BOOTSTRAP_PASSWORD setelah admin pertama dibuat.
ORDERGUARD_BOOTSTRAP_USERNAME=<staging-owner>
ORDERGUARD_BOOTSTRAP_NAME=Staging Owner
ORDERGUARD_BOOTSTRAP_PASSWORD=<generate-20-plus-random-characters>

# ---------- TikTok Shop (opsional) ----------
# Kosongkan seluruh blok ini jika integrasi TikTok dinonaktifkan.
TIKTOK_APP_KEY=<staging-app-key>
TIKTOK_APP_SECRET=<staging-app-secret>
TIKTOK_REDIRECT_URI=https://<staging-host>/api/tiktok/callback
ORDERGUARD_TOKEN_ENCRYPTION_KEY=<32-byte-hex-or-base64>
# TIKTOK_RETURNS_PATH=/return_refund/202309/returns/search

# ---------- Backup runner (bukan web service) ----------
ORDERGUARD_BACKUP_DIR=/tmp/orderguard-backups
ORDERGUARD_BACKUP_ENCRYPTION_KEY=<32-byte-hex-or-base64>
# ORDERGUARD_BACKUP_PREVIOUS_ENCRYPTION_KEYS=<only-during-rotation>
# ORDERGUARD_BACKUP_NEW_ENCRYPTION_KEY=<only-during-rotation>
ORDERGUARD_BACKUP_KEEP=30

# Pilih salah satu tujuan off-site nyata.
ORDERGUARD_BACKUP_OFFSITE_S3_URI=s3://<staging-bucket>/orderguard/
# ORDERGUARD_BACKUP_OFFSITE_RCLONE_REMOTE=<rclone-remote>:orderguard/

# Jangan gunakan mirror lokal sebagai disaster recovery.
# ORDERGUARD_BACKUP_OFFSITE_DIR=
# Jangan aktifkan plaintext di staging/production.
# ORDERGUARD_BACKUP_ALLOW_PLAINTEXT=1

# IAM staging dengan least privilege untuk bucket staging.
AWS_ACCESS_KEY_ID=<staging-access-key>
AWS_SECRET_ACCESS_KEY=<staging-secret-key>
AWS_REGION=ap-southeast-1
# AWS_ENDPOINT_URL=<optional-s3-compatible-endpoint>

# ---------- Konfirmasi operasi destruktif (hanya saat menjalankan) ----------
# ORDERGUARD_CONFIRM_RESTORE=<nama-database-target>
# ORDERGUARD_CONFIRM_ROTATE_KEYS=<absolute-backup-directory>
# ORDERGUARD_CONFIRM_INTEGRITY=<nama-database>
# ORDERGUARD_CONFIRM_VALIDATE_CONSTRAINTS=<nama-database>
# ORDERGUARD_CONFIRM_QUARANTINE_PRUNE=<nama-database>
ORDERGUARD_QUARANTINE_RETENTION_DAYS=90

# ---------- JANGAN diatur di staging ----------
# TEST_DATABASE_URL
# E2E_SCHEMA
# LOAD_TEST_PORT
# LOAD_TEST_SCHEMA
# ORDERGUARD_TEST_USERS
# ORDERGUARD_TEST_SEED_DEMO
