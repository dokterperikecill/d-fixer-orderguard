{
  "name": "dfixer-orderguard",
  "version": "1.0.0",
  "description": "D'Fixer OrderGuard MVP backend and frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test backend.test.js tiktok-shop.test.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "desktop:dev": "electron electron/main.js",
    "desktop:dist": "node scripts/build-desktop.js"
  },
  "build": {
    "appId": "id.dfixer.orderguard",
    "productName": "D'Fixer OrderGuard",
    "directories": {
      "output": "release/desktop"
    },
    "files": [
      "!**/*",
      "electron/main.js",
      "desktop.config.json",
      "public/icons/orderguard.ico"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/orderguard.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  }
}
